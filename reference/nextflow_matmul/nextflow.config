params {
    num_blocks      = 3
    elems_per_block = 64
    seed            = 0
    outdir          = 'results'
}

process {
    executor = 'local'
}

// --- instrumentation added for makespan / cpu / parallelism-efficiency analysis ---
trace {
    enabled   = true
    file      = 'analises_trace.tsv'
    fields    = 'name,status,submit,start,complete,duration,realtime,%cpu,rss,peak_rss'
}
report {
    enabled = true
    file    = 'analises_report.html'
}
timeline {
    enabled = true
    file    = 'analises_timeline.html'
}
