profiles {
    docker {
        docker.enabled = true
        // Usando uma imagem base que contenha Python e GROMACS, ou a rna-seq nf customizada
        process.container = 'nextflow/rnaseq-nf:latest' 
        // Alternativamente, use uma imagem oficial do GROMACS se preferir:
        // process.container = 'docker.io/gromacs/gromacs:latest'
    }

    conda {
        conda.enabled = true
        process.conda = "$projectDir/conda.yml"
    }
}