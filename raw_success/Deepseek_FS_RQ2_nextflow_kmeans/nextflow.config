profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--rm -v $PWD:$PWD'
        process.container = 'gromacs/gromacs:latest'
    }
    
    conda {
        conda.enabled = true
        process.conda = "$projectDir/environment.yml"
    }
    
    local {
        // Configuração para execução local
    }
}

manifest {
    defaultProfile = 'local'
}

timeline {
    enabled = true
    file = 'timeline.html'
}

report {
    enabled = true
    file = 'report.html'
}

trace {
    enabled = true
    file = 'trace.txt'
}