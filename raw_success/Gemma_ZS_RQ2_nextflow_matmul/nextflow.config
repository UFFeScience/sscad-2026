process {
    withName: KMEANS {
        container = 'python:3.9-slim'
        beforeScript = 'pip install scikit-learn pandas numpy'
    }
    withName: MATMUL {
        container = 'python:3.9-slim'
        beforeScript = 'pip install numpy'
    }
    withName: LYSOZYME_GROMACS {
        container = 'gromacs/gromacs:latest'
    }
}

docker.enabled = false