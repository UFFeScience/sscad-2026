// ============================================
// CONFIGURAÇÕES GERAIS DO NEXTFLOW
// ============================================

manifest {
    name = "Nextflow Workflows - KMeans, MatMul, Lysozyme"
    author = "Seu Nome"
    description = "Workflows para KMeans, MatMul e Lysozyme com GROMACS"
    version = "1.0.0"
}

// ============================================
// CONFIGURAÇÕES DE PARÂMETROS
// ============================================

params {
    // Parâmetros para KMeans
    kmeans_data = "dummy_data.txt"
    kmeans_n_clusters = 3
    kmeans_random_state = 42
    
    // Parâmetros para MatMul
    matmul_size = 1000
    
    // Parâmetros para Lysozyme
    lysozyme_pdb = "1aki.pdb"
    lysozyme_forcefield = "charmm36"
    lysozyme_water = "tip3p"
    lysozyme_nsteps_md = 100000
    lysozyme_nsteps_em = 50000
    lysozyme_nsteps_npt = 50000
    lysozyme_temperature = 300
    lysozyme_pressure = 1.0
}

// ============================================
// CONFIGURAÇÕES DE EXECUÇÃO
// ============================================

process {
    executor = 'local'
    cpus = 4
    memory = '8 GB'
    time = '1h'
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Configurações específicas por processo
    withName: 'kmeans_algorithm' {
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
    
    withName: 'matmul_algorithm' {
        cpus = 4
        memory = '8 GB'
        time = '1h'
    }
    
    withName: 'pdb2gmx|editconf|solvate|genion|minim_em|npt_eq|md_run' {
        cpus = 8
        memory = '16 GB'
        time = '4h'
        container = 'gromacs/gromacs:latest'
        containerOptions = '--volume /tmp:/tmp'
    }
    
    withName: 'minim_em|npt_eq|md_run' {
        cpus = 8
        memory = '16 GB'
        time = '8h'
        queue = 'high_memory'  // Se usar cluster
    }
}

// ============================================
// CONFIGURAÇÕES DE DOCKER/SINGULARITY
// ============================================

docker {
    enabled = false
    // runOptions = '--rm -v /tmp:/tmp'
}

singularity {
    enabled = false
    // autoMounts = true
}

// ============================================
// CONFIGURAÇÕES DE CLUSTER (SLURM, PBS, etc.)
// ============================================

// Exemplo para SLURM
// executor {
//     name = 'slurm'
//     queueSize = 10
//     submitRateLimit = '10 sec'
// }
// 
// process {
//     withName: 'md_run' {
//         queue = 'gpu'
//         cpus = 16
//         memory = '32 GB'
//         time = '24h'
//         clusterOptions = '--gres=gpu:1'
//     }
// }

// ============================================
// CONFIGURAÇÕES DE SAÍDA E LOGS
// ============================================

workDir = './work'
report = { 
    file("${params.outdir}/report.html") 
}
timeline = { 
    file("${params.outdir}/timeline.html") 
}
trace = { 
    file("${params.outdir}/trace.txt") 
}
dag = { 
    file("${params.outdir}/dag.dot") 
}

// ============================================
// CONFIGURAÇÕES DE AMBIENTE
// ============================================

env {
    // Variáveis de ambiente para GROMACS
    GMX_MAXBACKUP = '-1'
    GMX_FORCE_UPDATE = '1'
    OMP_NUM_THREADS = { 
        task.cpus ?: 1 
    }
}

// ============================================
// INCLUSÃO DE MÓDULOS EXTERNOS
// ============================================

// includeConfig 'modules/gromacs.config'
// includeConfig 'modules/python.config'

// ============================================
// PROFILES DE EXECUÇÃO
// ============================================

profiles {
    // Perfil padrão (local)
    standard {
        includeConfig 'nextflow.config'
    }
    
    // Perfil para desenvolvimento (menos recursos)
    dev {
        process {
            cpus = 2
            memory = '4 GB'
            time = '30m'
            
            withName: 'md_run' {
                cpus = 4
                memory = '8 GB'
                time = '1h'
            }
        }
        params {
            matmul_size = 100
            lysozyme_nsteps_md = 1000
            lysozyme_nsteps_em = 1000
            lysozyme_nsteps_npt = 1000
        }
    }
    
    // Perfil para produção (máximo de recursos)
    production {
        process {
            cpus = 16
            memory = '64 GB'
            time = '48h'
            
            withName: 'md_run' {
                cpus = 32
                memory = '128 GB'
                time = '72h'
            }
        }
        params {
            matmul_size = 5000
            lysozyme_nsteps_md = 1000000
        }
    }
    
    // Perfil para GPU
    gpu {
        process {
            withName: 'md_run' {
                cpus = 16
                memory = '32 GB'
                time = '24h'
                clusterOptions = '--gres=gpu:1'
            }
        }
        docker {
            enabled = true
            runOptions = '--gpus all'
        }
    }
    
    // Perfil para cluster SLURM
    slurm {
        executor {
            name = 'slurm'
            queueSize = 20
            submitRateLimit = '10 sec'
        }
        process {
            queue = 'normal'
            cpus = 8
            memory = '16 GB'
            time = '24h'
        }
    }
    
    // Perfil para AWS Batch
    awsbatch {
        executor {
            name = 'awsbatch'
            queue = 'nextflow-queue'
            region = 'us-east-1'
        }
        process {
            container = 'nextflow/gromacs:latest'
            memory = '32 GB'
            cpus = 16
        }
    }
}

// ============================================
// CONFIGURAÇÕES DE NOTIFICAÇÃO
// ============================================

// Notificações por email
// notifications {
//     onComplete = { 
//         sendEmail('user@example.com', 'Workflow completed') 
//     }
//     onError = { 
//         sendEmail('user@example.com', 'Workflow failed') 
//     }
// }

// ============================================
// DIRETÓRIOS DE SAÍDA
// ============================================

params.outdir = './results'

// Criar diretórios automaticamente
process {
    beforeScript = 'mkdir -p ${params.outdir}/{kmeans,matmul,lysozyme}'
}

// ============================================
// PUBLISH DIR (publicar resultados)
// ============================================

process {
    withName: 'kmeans_algorithm' {
        publishDir = [
            path: { "${params.outdir}/kmeans" },
            mode: 'copy',
            overwrite: true
        ]
    }
    
    withName: 'matmul_algorithm' {
        publishDir = [
            path: { "${params.outdir}/matmul" },
            mode: 'copy',
            overwrite: true
        ]
    }
    
    withName: 'prepare_gro|pdb2gmx|editconf|solvate|genion|minim_em|npt_eq|md_run' {
        publishDir = [
            path: { "${params.outdir}/lysozyme/${task.process}" },
            mode: 'copy',
            overwrite: true,
            pattern: '*.{gro,top,itp,xtc,edr,log,out}'
        ]
    }
}